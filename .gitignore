# Python 编译文件
__pycache__/
*.py[cod]
*$py.class
*.so

# Python 虚拟环境
.Python
venv/
env/
ENV/
.venv

# 打包产物
build/
dist/
*.egg-info/
.eggs/
*.egg
*.spec

# 测试覆盖率
.pytest_cache/
.coverage
htmlcov/
.pytest_cache/

# IDE 配置
.vscode/
.idea/
plans/
.trae/
*.swp
*.swo
*~

# IDE / 工具产生的临时目录 (纯缓存, 不入库)
# 注意: gitignore 只认行首的 #, 行尾注释会被当成路径的一部分, 必须单独占一行
# vite 依赖预构建缓存 (根目录那份, IDE 预览时生成)
.vite/
# Trae IDE 的 HTML 分享打包产物
.trae-html-share-packages/
# 截图临时目录
.screenshots/

# 日志文件
*.log

# Excel 文件（数据文件）
*.xlsx
*.xls

# 图标文件（如果需要提交，请移除此行）
*.ico

# 配置文件（包含敏感信息）
config.json
config.example.json
.clinerules

# 临时文件
temp.xlsx
*.tmp
*.bak

# 操作系统文件
.DS_Store
Thumbs.db

# Markdown / 纯文本文档：默认不入库（草稿、笔记、临时产物）
*.md
*.txt
# 业务文档按需白名单放行 —— 领域模型是团队共用的唯一事实来源，必须入库
!docs/domain-rules.md
# GitHub 仓库首页说明必须入库
!README.md
# 界面美化方案（设计说明 + 高保真概念稿）需入库
!界面美化方案/美化方案.md

# ===== Tauri / 前端 (v2) =====
node_modules/
dist/
dist-ssr/
*.local

# 压力测试生成的大文件 (tools/gen-big-xlsx.py 产出, 4MB+)
big-test.xlsx

# 分发包: 只提交源文件(使用说明.md), 打包产物由
# tools/package-release.py 生成, 不入库
dist-package/*
!dist-package/使用说明.md

# Tauri Rust 构建产物
src-tauri/target/
src-tauri/gen/

# TypeScript 增量编译
*.tsbuildinfo

# vitest 的临时目录 (沙盒环境下 node-compile-cache 偶发 EPERM,
# 需把 TMPDIR 指到项目内再用; 目录本身不入库)
.tmp-vitest/

