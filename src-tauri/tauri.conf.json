{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JIG Data Finder",
  "version": "2.0.0",
  "identifier": "com.jigdatafinder.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JIG Data Finder",
        "width": 1400,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": {},
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}