/* style.qss - 现代极简风格 */

/* === 1. 全局字体与背景 === */
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #333333;
}

/* 整个窗口的背景色：浅灰 */
QWidget#MainContent {
    background-color: #F2F4F8;
}

/* === 2. 卡片化容器 === */
QFrame#CardFrame {
    background-color: #FFFFFF;  /* 纯白背景 */
    border: 1px solid #E2E8F0;  /* 极淡的边框 */
    border-radius: 8px;         /* 圆角 */
}

/* === 3. 标题文字 === */
QLabel {
    color: #475569; /* 深灰蓝 */
}
QLabel#SectionTitle {
    font-size: 14px;
    font-weight: bold;
    color: #1E293B;
}

/* === 4. 输入框优化 === */
QLineEdit, QTextEdit,QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 6px;
    color: #334155;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3B82F6; /* 聚焦变蓝 */
    background-color: #F8FAFC;
}

/* === 5. 按钮基础样式 === */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #475569;
    padding: 5px 15px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

/* === 6. 核心按钮：颜色加强 === */

/* 蓝色按钮 (加载 & 查询) */
QPushButton#btn_load, QPushButton#btn_query, QPushButton#btn_ok {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    color: #FFFFFF;
}
QPushButton#btn_load:hover, QPushButton#btn_query:hover, QPushButton#btn_ok:hover {
    background-color: #1D4ED8;
}
QPushButton#btn_load:pressed, QPushButton#btn_query:pressed,QPushButton#btn_ok:pressed {
    background-color: #1E40AF;
    padding-top: 6px;
}
QPushButton#btn_query:disabled {
    background-color: #94A3B8;
    border-color: #94A3B8;
}

/* 绿色按钮 (导出) */
QPushButton#btn_export {
    background-color: #10B981;
    border: 1px solid #10B981;
    color: #FFFFFF;
}
QPushButton#btn_export:hover {
    background-color: #059669;
}

/* 红色按钮 (清空) */
QPushButton#btn_clear {
    background-color: #FEF2F2;
    color: #EF4444;
    border: 1px solid #FECACA;
    font-size: 12px;
}
QPushButton#btn_clear:hover {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
}

/* === 7. 表格深度美化 === */
QTableView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    gridline-color: #E2E8F0;
    selection-background-color: #E0F2FE; /* 选中底色：淡蓝 */
    selection-color: #0F172A; /* 选中文字：深黑 */
}

/* --- 表头容器样式 --- */
/* 这里设置为白色，就能把右边多余的灰色区域变成白色 */
QHeaderView {
    background-color: #FFFFFF; 
    border: none;

}

/* 表头 */
QHeaderView::section {
    background-color: #F8FAFC;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #E2E8F0;
    font-weight: bold;
    color: #64748B;
}
QHeaderView::section:vertical {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

/* 滚动条隐藏背景 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === 8. 分割器美化 (解决间距视觉问题) === */
QSplitter::handle {
    /* 设置为透明，让它看起来像空隙 */
    background-color: transparent; 
}

/* 可选：鼠标悬停在空隙时，显示一点点颜色提示可以拖动 */
QSplitter::handle:hover {
    background-color: #E2E8F0; 
}

/* === 9. 表格滚动条补充 (防止列宽不自动缩放时太丑) === */
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === 10. 自定义状态栏样式 === */
QWidget#CustomStatusBar {
    background-color: #F8FAFC; /* 浅灰底色 */
    border: 1px solid #E2E8F0;
    border-radius: 6px; 

}

/* 为状态标签设置特定样式 */
QLabel#StatusLabel {
    font-size: 11px;
    color: #475569;
}

QLabel#LogLabel {
    font-size: 11px;
    color: #64748B;
}

/* === 11. 标签页样式 (TabWidget) - 胶囊风格修正版 === */

QTabWidget::pane {
    /* 1. [核心修改] 去除 Tab 页的所有外边框 */
    border: none; 
    
    /* 这里的背景可以设为透明，让它直接显示底层 CardFrame 的白色 */
    background: transparent;
    
    /* 让下方的表格内容和 Tab 胶囊之间留出一点呼吸感 */
    top: 8px; 
}

QTabWidget::tab-bar {
    /* 左对齐 */
    left: 0px; 
}

QTabBar::tab {
    /* 胶囊基础样式 */
    background: transparent;
    border: none;              /* 去除所有边框 */
    border-radius: 6px;        /* 圆角矩形 */
    
    /* 2. [核心修改] 增加宽度和间距，解决文字显示不全 */
    min-width: 100px;          
    padding: 8px 0px;          /* 上下撑开一点高度 */
    margin-right: 8px;         /* 胶囊之间的空隙 */
    
    /* 3. [核心修改] 字体颜色加深，解决不清晰 */
    color: #475569;            /* Slate-600，深灰色，对比度高 */
    font-weight: 600;          /* 半粗体 */
}

/* 鼠标悬停 */
QTabBar::tab:hover {
    background-color: #F1F5F9; /* 浅灰背景反馈 */
    color: #1E293B;            /* 接近黑色 */
}

/* 选中状态 */
QTabBar::tab:selected {
    /* 选中变为浅蓝色背景块 */
    background-color: #E0F2FE; /* 极淡的蓝色背景 */
    color: #0284C7;            /* 深蓝色文字 */
    font-weight: bold;
}

/* === 12. 进度条样式 === */
QProgressBar {
    /* [修改] 添加边框，让它不再与背景融为一体 */
    border: 1px solid #CBD5E1;
    
    background-color: #FFFFFF; /* 槽的背景改为白色，显得更干净 */
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2563EB;
    /* [修改] 进度块稍微留一点内边距效果（可选，或者保持填满） */
    border-radius: 2px;
}

/* === 13. 尺寸验证样式 === */

/* 尺寸不匹配的文本样式（红色） */
.size-mismatch {
    color: #EF4444;
    font-weight: bold;
}

/* 尺寸匹配的文本样式（绿色，可选） */
.size-match {
    color: #10B981;
    font-weight: normal;
}

/* 开关控件样式 */
QCheckBox#sizeValidationToggle {
    font-size: 12px;
    color: #475569;
}

QCheckBox#sizeValidationToggle::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox#sizeValidationToggle::indicator:checked {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    border-radius: 3px;
}

QCheckBox#sizeValidationToggle::indicator:unchecked {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
}

QCheckBox#sizeValidationToggle::indicator:checked:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QCheckBox#sizeValidationToggle::indicator:unchecked:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

/* =========================================
   14. 设置界面专属样式 (New) */

/* 1. 设置对话框主背景：浅灰 */
QDialog#SettingsDialog {
    background-color: #F2F4F8;
}

/* 2. 滚动区域透明 */
QScrollArea#SettingsScrollArea, 
QWidget#SettingsContentWidget {
    background-color: transparent; /* 关键：让底下的灰色透出来 */
    border: none;
}

/* 3. 卡片内标题 */
QLabel#CardTitle {
    font-size: 15px;
    font-weight: bold;
    color: #1E293B;
    padding-bottom: 4px;
}

/* 4. 卡片内分割线 */
QFrame#CardSeparator {
    color: #E2E8F0; /* 分割线颜色 */
    background-color: #E2E8F0;
}

/* 5. 底部按钮栏背景 */
QFrame#SettingsBottomBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

/* 6. 提示文字小号灰字 */
QLabel#TipLabel {
    color: #94A3B8;
    font-size: 12px;
}






